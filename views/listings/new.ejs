<% layout("layouts/boilerplate") %>

<div class="form-page-container">
  <div class="form-card">
    <div class="form-card-header">
      <span class="form-icon-badge"><i class="fa-solid fa-house-chimney-medical"></i></span>
      <h1>Wanderlust Your Home</h1>
      <p>List your unique space and welcome adventurers from across the globe.</p>
    </div>

    <form method="POST" action="/listings" novalidate class="needs-validation main-form">
      <!-- Title -->
      <div class="form-group">
        <label for="listingTitle" class="form-label">Property Title <span class="required">*</span></label>
        <input 
          type="text" 
          name="listing[title]" 
          id="listingTitle" 
          class="form-control" 
          placeholder="e.g. Luxurious Mountain Chalet with Panoramic Views" 
          required 
          minlength="4"
        />
        <div class="form-hint">Make it catchy and descriptive (min 4 characters).</div>
        <div class="invalid-feedback">Please provide a descriptive title for your listing.</div>
      </div>

      <!-- Category -->
      <div class="form-group">
        <label for="listingCategory" class="form-label">Category <span class="required">*</span></label>
        <select name="listing[category]" id="listingCategory" class="form-select" required>
          <option value="trending" selected>🔥 Trending</option>
          <option value="beach">🏖️ Beachfront</option>
          <option value="mountains">🏔️ Mountains</option>
          <option value="iconic-cities">🏙️ Iconic Cities</option>
          <option value="castles">🏰 Castles & Palaces</option>
          <option value="pools">🏊 Amazing Pools</option>
          <option value="camping">⛺ Camping & Glamping</option>
          <option value="farms">🚜 Countryside & Farms</option>
          <option value="arctic">❄️ Arctic & Snow</option>
          <option value="luxury">💎 Luxury Stays</option>
          <option value="rooms">🛏️ Private Rooms</option>
          <option value="boats">⛵ Boats & Houseboats</option>
        </select>
        <div class="invalid-feedback">Please select a category.</div>
      </div>

      <!-- Description -->
      <div class="form-group">
        <label for="listingDescription" class="form-label">Description <span class="required">*</span></label>
        <textarea 
          name="listing[description]" 
          id="listingDescription" 
          rows="5" 
          class="form-control" 
          placeholder="Describe your place, bedroom arrangements, surroundings, unique amenities, and why guests will love it..." 
          required
        ></textarea>
        <div class="invalid-feedback">Please provide a detailed description.</div>
      </div>

      <!-- Image URL with Live Preview -->
      <div class="form-group">
        <label for="listingImage" class="form-label">Cover Image URL</label>
        <input 
          type="url" 
          name="listing[image]" 
          id="listingImage" 
          class="form-control" 
          placeholder="https://images.unsplash.com/photo-..." 
          oninput="updateImagePreview(this.value)"
        />
        <div class="form-hint">Paste an image link from Unsplash, Pexels, or any image host. Leave blank for default cover.</div>
        <!-- Live Image Preview Box -->
        <div class="image-preview-wrapper" id="previewContainer">
          <p class="preview-label">Live Image Preview:</p>
          <img id="imagePreview" src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1200" alt="Preview" class="form-image-preview">
        </div>
      </div>

      <!-- Price & Location in 2 Columns -->
      <div class="form-row-2">
        <div class="form-group">
          <label for="listingPrice" class="form-label">Nightly Price (₹ INR) <span class="required">*</span></label>
          <div class="input-prefix-wrapper">
            <span class="input-prefix">₹</span>
            <input 
              type="number" 
              name="listing[price]" 
              id="listingPrice" 
              class="form-control with-prefix" 
              placeholder="4500" 
              min="100" 
              required
            />
          </div>
          <div class="invalid-feedback">Please enter a valid price (minimum ₹100).</div>
        </div>

        <div class="form-group">
          <label for="listingLocation" class="form-label">City / Town <span class="required">*</span></label>
          <input 
            type="text" 
            name="listing[location]" 
            id="listingLocation" 
            class="form-control" 
            placeholder="e.g. Manali, Himachal Pradesh" 
            required
          />
          <div class="invalid-feedback">Please specify the location.</div>
        </div>
      </div>

      <!-- Country -->
      <div class="form-group">
        <label for="listingCountry" class="form-label">Country <span class="required">*</span></label>
        <input 
          type="text" 
          name="listing[country]" 
          id="listingCountry" 
          class="form-control" 
          placeholder="e.g. India" 
          required
        />
        <div class="invalid-feedback">Please enter the country.</div>
      </div>

      <!-- Submit & Cancel Buttons -->
      <div class="form-actions-row">
        <a href="/listings" class="btn-cancel">Cancel</a>
        <button type="submit" class="btn-primary btn-submit-form">
          <i class="fa-solid fa-plus-circle"></i> Publish Listing
        </button>
      </div>
    </form>
  </div>
</div>